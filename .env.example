# Database
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=worldcup
MYSQL_USER=worldcup
MYSQL_PASSWORD=worldcuppass
DATABASE_URL=mysql+pymysql://worldcup:worldcuppass@db:3306/worldcup

# Security
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_DAYS=7

# Admin seed credentials (created on first startup)
ADMIN_NICKNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_REAL_NAME=Administrator

# App settings
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# TheSportsDB (https://www.thesportsdb.com) — free tier key is "3", no registration needed
# Get a Patreon key at https://www.patreon.com/thesportsdb for higher rate limits
SPORTSDB_API_KEY=3
# SPORTSDB_LEAGUE_ID=4429   # FIFA World Cup (default)
# SPORTSDB_SEASON=2026      # (default)
